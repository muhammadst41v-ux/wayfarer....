# AI_API_KEY / GEMINI_API_KEY: Required for live Gemini AI API trip planner.
# If omitted or mock, the app automatically falls back to the intelligent local rule-based itinerary scout.
AI_API_KEY=""
GEMINI_API_KEY=""

# GOOGLE_MAPS_KEY: Optional Google Maps JavaScript API Key for interactive map tiles.
# If omitted, Wayfarer automatically defaults to free OpenStreetMap + Leaflet tiles.
GOOGLE_MAPS_KEY=""

# GOOGLE_PLACES_KEY: Optional Google Places API (New) key for live hotel, restaurant, and amenity search.
# If omitted, Wayfarer automatically falls back to curated field dossiers in /src/data and OpenStreetMap.
GOOGLE_PLACES_KEY=""

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for live travel vlog search.
# If omitted, Wayfarer seamlessly serves curated high-definition YouTube nocookie embeds.
YOUTUBE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
